# Copy to .env. Never commit .env. Environment variables take precedence.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Request timeout in seconds; the entire scan is independently time-limited.
DEEPSEEK_TIMEOUT=120
DEEPSEEK_RETRIES=2

# Optional: dashboard Actions monitoring. Otherwise existing Git login is used.
# Fine-grained repository token: Actions read + Metadata read. Never commit a real token.
GH_TOKEN=
